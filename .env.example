# Protected-cloud configuration schema only. Do not copy or populate this file
# as `.env` on the Mac. Never place a credential value in the repository.
#
# The outer controller reads DAYTONA_API_KEY only to create/delete cloud
# sandboxes; it must arrive from a protected GitHub environment secret and is
# intentionally not assigned here. All *_SECRET_SOURCE values are names of
# provider-managed governed organization secrets, not their plaintext values;
# one-use behavior is enforced by Dark Factory's signed application policy.
DF_CLOUD_PROVIDER=daytona
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DF_CLOUD_REGION_CLASS=
DF_TRUSTED_CONTROL_PLANE=1
DF_TRUSTED_VOLUME_ROOT=/trusted/dark-factory

# Essentials-only MVP workflow aliases. These point only to existing resources;
# the MVP does not create or configure Azure deployments. Deployment aliases
# are 1-128 lowercase alphanumeric segments separated by one ".", "_", or "-".
DF_MVP_CAMPAIGN_ID=
DF_MVP_MAX_ITERATIONS=1
DF_MVP_DAYTONA_IMAGE=
DF_FOUNDRY_BASE_URL=
DF_OPTIMIZER_DEPLOYMENT=
DF_EVALUATED_DEPLOYMENT=

# Trusted controller bootstrap. The API key used by GitHub-hosted bootstrap is
# a GitHub environment secret; DF_CONTROL_DAYTONA_SECRET_SOURCE is the name of
# a separate Daytona organization Secret mounted into the controller.
DF_DAYTONA_VOLUME_ID=
DF_DAYTONA_VOLUME_SUBPATH=
DF_CONTROL_DAYTONA_SECRET_SOURCE=
DF_CONTROL_SECRET_BINDINGS_JSON=[]
DF_CONTROL_TTL_MINUTES=300
DF_CONTROL_NETWORK_ALLOW_DOMAINS=app.daytona.io,api.github.com,github.com
DF_CONTROL_CPU=4
DF_CONTROL_MEMORY_GIB=8
DF_CONTROL_DISK_GIB=40
DF_CAMPAIGN_ID=
DF_CAMPAIGN_STATE_ROOT=/trusted/dark-factory/campaign-state

# Required only by the protected cloud workflow for a paid optimize command:
# RUN:<campaign-id>:<exact DF_CONTROL_IMAGE_DIGEST>
DF_PAID_RUN_AUTHORIZATION=

# Every workload image must be an OCI digest reference. The digest field must
# exactly match the @sha256 suffix of its reference.
DF_CONTROL_IMAGE_REFERENCE=
DF_CONTROL_IMAGE_DIGEST=
DF_OPTIMIZER_IMAGE_REFERENCE=
DF_OPTIMIZER_IMAGE_DIGEST=
DF_BUILD_IMAGE_REFERENCE=
DF_BUILD_IMAGE_DIGEST=
DF_EVALUATOR_IMAGE_REFERENCE=
DF_EVALUATOR_IMAGE_DIGEST=

# Existing Microsoft Foundry deployment binding. Supply only the lowercase
# public resource name, never a URL: the trusted runtimes derive
# https://<resource>.services.ai.azure.com/anthropic and allow only that host.
# The same existing resource hosts both exact deployment names below.
DF_FOUNDRY_RESOURCE_NAME=

# Claude Code optimizer identity and its isolated Foundry API-key binding.
DF_OPTIMIZER_MODEL=claude-opus-5
# Exact existing Azure deployment name; it need not equal the model ID.
DF_OPTIMIZER_DEPLOYMENT_NAME=
DF_OPTIMIZER_EFFORT=high
DF_CLAUDE_CODE_VERSION=2.1.217
DF_OPTIMIZER_SECRET_SOURCE=DF_FOUNDRY_API_KEY
DF_OPTIMIZER_SECRET_TARGET=ANTHROPIC_FOUNDRY_API_KEY

# Pi's evaluated model identity. This JSON contains secret names and target
# environment names only. The source names a protected Daytona organization
# secret containing the already-issued Foundry key.
DF_EVALUATED_PROVIDER=microsoft-foundry
DF_EVALUATED_MODEL=claude-opus-4-8
# Exact existing Azure deployment name; it need not equal the model ID.
DF_EVALUATED_DEPLOYMENT_NAME=
DF_EVALUATED_REASONING=high
DF_EVALUATED_SECRET_BINDINGS_JSON=[{"sourceEnvironmentName":"DF_FOUNDRY_API_KEY","targetEnvironmentName":"ANTHROPIC_FOUNDRY_API_KEY"}]

# Private Pi Git access is granted only to the cloud Git wrapper. The Daytona
# Secret value must be Base64(x-access-token:<fine-grained-token>) with no
# `Basic ` prefix; it is used only as an HTTPS Authorization header and must be
# host-restricted to github.com/api.github.com. Claude Code never receives it.
DF_GITHUB_SECRET_SOURCE=

# Exact private Pi fork observed when this MVP was initialized. These values
# are not trusted merely because they appear here: the protected cloud Git
# worker must independently verify the private origin, exact objects, package
# lock, package metadata, canonical upstream, and merge base before experiment
# 000 can be sealed. Update all identities together if the authorized baseline
# intentionally moves.
DF_PI_GITHUB_OWNER=parallaxai
DF_PI_GITHUB_REPOSITORY=df-pi-tbench
DF_PI_BRANCH=main
DF_PI_BASELINE_COMMIT=5bc1c2c0a6f07e00e8c240304182f213ab8d311f
DF_PI_BASELINE_TREE=73898c76210cc8b48f4ac07cc76397b6b5c00758
DF_PI_PACKAGE_LOCK_SHA256=472f0726dc79f3b38df58d8a8bce96bf56fbf993a134b49aabc54947b8461e59
DF_PI_CODING_AGENT_VERSION=0.82.1

# Protected-workflow, one-line canonical JSON. This signed, task-free
# descriptor binds the campaign and protocol to one immutable trusted://
# production-composition artifact plus independently governed authority,
# verification-key-set, and verifier-policy commitments. JSON never names or
# constructs an executable runtime port.
DF_PRODUCTION_OPTIMIZE_BOOTSTRAP_DESCRIPTOR_JSON=

# Credentials Harbor needs to create its child cloud task sandboxes. These
# targets must be disjoint from evaluated-model targets. Daytona example:
# [{"sourceEnvironmentName":"DF_DAYTONA_NESTED_SECRET","targetEnvironmentName":"DAYTONA_API_KEY"}]
DF_HARBOR_SECRET_BINDINGS_JSON=
# MVP workflow form of the same evaluator-only Daytona organization Secret.
# This is a provider secret name, never the outer GitHub API-key value. Restrict
# it to app.daytona.io. Harbor separately receives
# DF_EVALUATED_SECRET_SOURCE as the organization Secret *name* and attaches a
# fresh ANTHROPIC_FOUNDRY_API_KEY placeholder to each eligible direct child
# task sandbox.
DF_HARBOR_DAYTONA_SECRET_SOURCE=

DF_MODE=research
DF_LEADERBOARD_ELIGIBILITY=unverified
DF_TRUSTED_ZONE=
DF_SIGNING_KEY_ID=

# Terminal-Bench 2.1 / Harbor pin. The source decoder currently targets Harbor
# 0.20.0, but the production value remains blank until the protected pin
# discovery receipt verifies the selected exact release and hashes.
# The evaluator-private MVP runtime pin additionally records absolute Harbor
# and Bun paths/digests, the adapter digest, Linux x64 glibc ABI, and at least
# five exact direct-Daytona task revisions whose verifier mode is `separate`
# for every step. Those task-bearing values never belong in this public file.
DF_HARBOR_VERSION=
DF_TBENCH_REGISTRY_REVISION=
DF_TBENCH_DATASET_CONTENT_SHA256=
DF_TBENCH_DATASET_MANIFEST_SHA256=
DF_HARBOR_PACKAGE_SHA256=
DF_HARBOR_EXECUTABLE_SHA256=
DF_PI_HARBOR_ADAPTER_SHA256=

# Rolling research-campaign limits. The attempt ceiling includes candidate,
# champion, and infrastructure-replacement attempts.
DF_BUDGET_USD=
DF_BUDGET_TOKENS=
DF_BUDGET_WALL_TIME_MINUTES=
DF_BUDGET_ATTEMPTS=
DF_BUDGET_PRIVACY_RELEASES=
DF_BUDGET_PROMOTION_LOOKS=
DF_BUDGET_ONLINE_ERROR=0.05
